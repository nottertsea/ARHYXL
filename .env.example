# Server
PORT=3000
NODE_ENV=development

# Frontend URL(s), comma-separated in production
FRONTEND_ORIGIN=http://localhost:3000

# Payment provider: test or live
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_CALLBACK_URL=http://localhost:3000/confirmation.html
# Keep PAYSTACK_SECRET_KEY server-side; never place it in frontend files.

# SMTP email delivery for email confirmation and password reset
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=arhyXL <noreply@example.com>

# Twilio SMS delivery for phone confirmation
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+12345678900

# Use sqlite for local fallback or mysql for local/production MySQL.
DB_CLIENT=mysql
SQLITE_PATH=arhyxl.sqlite

# MySQL connection (used when DB_CLIENT=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=arhyxl
MYSQL_USER=arhyxl_app
MYSQL_PASSWORD=replace_me
MYSQL_SSL=false

# Owner account provisioned when the backend starts
OWNER_EMAIL=heistertsea@outlook.com
OWNER_PASSWORD=replace_me

# Paystack webhook signing secret is the Paystack secret key.
